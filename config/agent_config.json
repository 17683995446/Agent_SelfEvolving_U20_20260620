{
  "agent_name": "SelfEvolvingAgent",
  "version": "1.0.0",
  "log_level": "INFO",
  "data_dir": "./data",
  "max_cpu_percent": 20.0,
  "max_memory_mb": 512.0,
  "max_disk_gb": 10.0,
  "main_loop_interval_ms": 1000,
  "enable_offline_review": true,
  "idle_threshold_seconds": 300,
  "perception_interval_ms": 1000,
  "anomaly_threshold": 0.7,
  "state_history_window": 60,
  "safety_weight": 0.4,
  "gain_weight": 0.4,
  "efficiency_weight": 0.2,
  "exploration_weight": 0.0,
  "exploration_ratio": 0.3,
  "exploration_bonus": 0.3,
  "max_task_pool_size": 100,
  "task_timeout_seconds": 300,
  "max_concurrent_tasks": 3,
  "prediction_horizon": 10,
  "gru_hidden_dim": 64,
  "gru_num_layers": 2,
  "online_learning_rate": 0.001,
  "model_save_interval": 1000,
  "short_term_memory_size": 10000,
  "long_term_db_path": "./data/memory.db",
  "snapshot_dir": "./data/snapshots",
  "replay_buffer_size": 1000,
  "enable_structural_evolution": false,
  "offline_review_interval_hours": 24,
  "max_optimization_iterations": 3,
  "forbidden_paths": [
    "/etc",
    "/usr/bin",
    "/bin",
    "/sbin",
    "/sys",
    "/proc"
  ],
  "max_exploration_without_reward": 5,
  "enable_auto_rollback": true,
  "emergency_cpu_threshold": 0.95,
  "emergency_mem_threshold": 0.95,
  "emergency_disk_threshold": 0.95,
  "execution_dry_run": true,
  "auto_load_state": true,
  "working_memory_capacity": 7,
  "skill_max_count": 100,
  "collaboration_heartbeat_interval_seconds": 3.0,
  "skill_evolution_min_invocations": 3,
  "precision_target": 0.01,
  "coverage_target": 0.95,
  "efficiency_target": 0.1
}